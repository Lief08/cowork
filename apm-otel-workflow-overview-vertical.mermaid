flowchart TD
    classDef oe fill:#1e40af,color:#ffffff,stroke:#1e3a8a,stroke-width:2px
    classDef oe_hdr fill:#1e3a8a,color:#ffffff,stroke:#1e3a8a,stroke-width:3px,font-weight:bold
    classDef pe fill:#6d28d9,color:#ffffff,stroke:#5b21b6,stroke-width:2px
    classDef pe_hdr fill:#5b21b6,color:#ffffff,stroke:#5b21b6,stroke-width:3px,font-weight:bold
    classDef ad fill:#0f766e,color:#ffffff,stroke:#0d9488,stroke-width:2px
    classDef val_hdr fill:#064e3b,color:#ffffff,stroke:#065f46,stroke-width:3px,font-weight:bold
    classDef rb_hdr fill:#7f1d1d,color:#ffffff,stroke:#991b1b,stroke-width:3px,font-weight:bold
    classDef shared fill:#065f46,color:#ffffff,stroke:#064e3b,stroke-width:2px
    classDef handoff fill:#92400e,color:#ffffff,stroke:#78350f,stroke-width:4px
    classDef rollback fill:#991b1b,color:#ffffff,stroke:#7f1d1d,stroke-width:2px
    classDef decision fill:#1f2937,color:#ffffff,stroke:#111827,stroke-width:2px
    classDef terminal fill:#14532d,color:#ffffff,stroke:#166534,stroke-width:3px
    classDef escalate fill:#4a1d96,color:#ffffff,stroke:#3b0764,stroke-width:2px

    PRE["STARTING CONDITIONS
    ───────────────────────
    Server and runtime already exist
    Both teams aligned on requirements
    All dependencies confirmed"]:::shared

    PRE --> GATE{"Ready to
    proceed?"}:::decision
    GATE -->|NO| HOLD["On Hold
    Resolve blockers
    before starting"]:::escalate
    GATE -->|YES| FORK

    FORK(["Observability Engineering
    begins parallel workstreams"]):::shared

    subgraph OE[" "]
        OE_HDR["OBSERVABILITY ENGINEERING"]:::oe_hdr

        COL["Deploy Telemetry Pipeline
        ──────────────────────────
        Install and configure the
        local data collection service"]:::oe

        AGT["Prepare Agent Package
        ──────────────────────────
        Stage instrumentation software
        and build configuration spec"]:::oe

        SYNC{"Both workstreams
        complete and healthy?"}:::decision

        OE_HDR --> COL & AGT
        COL --> SYNC
        AGT --> SYNC
    end

    FORK --> OE_HDR

    SYNC -->|NO| HOLD2["OE Resolves Blocker
    Completed workstream holds
    No rollback required yet"]:::rollback

    SYNC -->|YES| HANDOFF

    HANDOFF["━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    FORMAL HANDOFF  ·  OE → PE
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    OE delivers a complete configuration specification
    PE reviews, acknowledges, and accepts before proceeding
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"]:::handoff

    subgraph PE[" "]
        PE_HDR["PLATFORM ENGINEERING"]:::pe_hdr

        BAK["Back Up Current State
        ──────────────────────────
        Snapshot runtime configuration
        before any changes are applied"]:::pe

        CFG["Apply Agent Configuration
        ──────────────────────────
        Update runtime settings
        per OE specification"]:::pe

        RST{"Runtime restarted
        successfully?"}:::decision

        PE_HDR --> BAK --> CFG --> RST
    end

    HANDOFF --> PE_HDR

    RST -->|NO| RB_FAST["Immediate Rollback
    PE restores runtime from
    pre-change backup"]:::rollback

    subgraph VAL[" "]
        VAL_HDR["VALIDATION  ·  THREE-TEAM RESPONSIBILITY"]:::val_hdr

        VAL_FORK(["All three teams
        validate in parallel"]):::shared

        VOE["Observability Engineering
        ──────────────────────────
        Agent confirmed running
        Data reaching collection service
        Data visible in observability backend"]:::oe

        VPE["Platform Engineering
        ──────────────────────────
        Runtime available and stable
        Application logs show no errors
        No performance degradation observed"]:::pe

        VAD["Application Development
        ──────────────────────────
        Smoke tests passing
        Regression checks complete
        Business functionality confirmed"]:::ad

        VDEC{"All tracks
        passed?"}:::decision

        VAL_HDR --> VAL_FORK
        VAL_FORK --> VOE & VPE & VAD
        VOE --> VDEC
        VPE --> VDEC
        VAD --> VDEC
    end

    RST -->|YES| VAL_HDR

    VDEC -->|YES| DONE["INSTRUMENTATION COMPLETE
    ──────────────────────────────────
    Runtime is fully instrumented
    Telemetry is flowing end-to-end
    Change record closed"]:::terminal

    VDEC -->|NO| RB_DEC{"What
    failed?"}:::decision

    subgraph ROLLBACK[" "]
        RB_HDR["ROLLBACK & RECOVERY"]:::rb_hdr

        RB_T1["Tier 1 — PE Leads  ·  Immediate
        ──────────────────────────────────
        Restore runtime from pre-change backup
        Collect: JVM logs · agent output · env state"]:::rollback

        RB_T2["Tier 2 — OE Leads  ·  Immediate
        ──────────────────────────────────
        Remove collection service
        Collect: Collector logs · config · metrics"]:::rollback

        RB_T3["Tier 3 — Both Teams  ·  Immediate  ·  PE First
        ──────────────────────────────────
        Runtime rolled back then Collector removed
        Collect: all logs · full environment state"]:::rollback

        RCA(["Root Cause Analysis
        begins in parallel with rollback
        Always required — not optional"]):::shared

        RB_POST["Post-Rollback Verification  ·  Shared
        ──────────────────────────────────
        Runtime stable and application healthy
        No instrumentation artifacts remaining
        Diagnostic data preserved"]:::shared

        TIMEBOX{"Still within
        change window?"}:::decision

        CLOSE["Close Change Unsuccessful
        ──────────────────────────────────
        Change record closed — no incident required
        Rollback completed within window"]:::escalate

        INCIDENT["File Incident
        ──────────────────────────────────
        Extended impact beyond change window
        Incident management engaged"]:::escalate

        RCA_COMPLETE["RCA Required Before Any Retry
        ──────────────────────────────────
        RCA findings documented and accepted
        Scripts or process corrected and verified
        New change request approved and scheduled"]:::shared

        RB_HDR -->|"Agent or runtime"| RB_T1
        RB_HDR -->|"Collection service"| RB_T2
        RB_HDR -->|"Both or unclear"| RB_T3
        RB_T1 --> RCA
        RB_T2 --> RCA
        RB_T3 --> RCA
        RCA --> RB_POST
        RB_POST --> TIMEBOX
        TIMEBOX -->|YES| CLOSE
        TIMEBOX -->|NO| INCIDENT
        CLOSE --> RCA_COMPLETE
        INCIDENT --> RCA_COMPLETE
    end

    RB_DEC --> RB_HDR
    RB_FAST --> RCA
